# Monocron controller environment variables.
# Copy this file to /etc/monocron/controller.env and fill in the real PostgreSQL DSN.

MONOCRON_DATABASE_URL=postgres://user:password@localhost/monocron?sslmode=disable
MONOCRON_CONTROLLER_LISTEN=:8080
MONOCRON_METRICS_LISTEN=:9090
MONOCRON_LOG_LEVEL=info
