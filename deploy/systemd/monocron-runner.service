[Unit]
Description=Monocron Runner Agent
Documentation=https://github.com/Omotolani98/monocron
After=network-online.target monocrond.service
Wants=network-online.target
Requires=monocrond.service

[Service]
Type=simple
User=monocron
Group=monocron
ConfigurationDirectory=monocron
StateDirectory=monocron
EnvironmentFile=-/etc/monocron/runner.env
Environment="MONOCRON_RUNNER_CONFIG=/etc/monocron/runner.json"
Environment="MONOCRON_RUNNER_STATE_PATH=/var/lib/monocron/runner.state"
ExecStart=/usr/local/bin/monocron-runner
Restart=always
RestartSec=5

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/monocron /etc/monocron

[Install]
WantedBy=multi-user.target
