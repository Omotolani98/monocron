[Unit]
Description=Monocron Controller
Documentation=https://github.com/Omotolani98/monocron
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=monocron
Group=monocron
EnvironmentFile=-/etc/monocron/controller.env
ExecStart=/usr/local/bin/monocron-controller
ExecStartPre=/bin/sh -c 'test -s /etc/monocron/controller.env || (echo "Missing /etc/monocron/controller.env" && exit 1)'
Restart=on-failure
RestartSec=5
StartLimitIntervalSec=60
StartLimitBurst=3

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/monocron

[Install]
WantedBy=multi-user.target
